# Ignore everything
*

# Except Output folder and its contents
!Output/
!Output/**

# Whitelist specifically generated files, reject everything else (e.g. .dmg, .wav)
Output/**/*
!Output/**/
!Output/**/*.json
!Output/**/*.txt
!Output/**/*.log
!Output/**/*.html

# Keep .gitignore itself
!.gitignore

# Ignore RSS feeds folder inside Output
Output/*/rss_feeds/
Output/*/rss_feeds/**

# Ignore private internal state markers inside Output
Output/**/.importance_split_pending.json
Output/**/.image_update_pending.json
Output/**/.filter_pending_*
Output/**/tts_text_meta.json
Output/**/tts_generation_status.json
Output/**/tts_run_status.json

# Secure cookies - NEVER push to git
Input/gemini_cookies.json
gemini_chat_api/

# Dedicated image repository folder
ImageRepo/

# Local-only per-image tag sidecars
ImageTags/

# Scraper .py are versioned in a SEPARATE local-only repo (.scraper.git), NEVER on hirek
.scraper.git/
.pygit/
